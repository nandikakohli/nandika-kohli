{
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix svelte-website run dev --",
    "dev:react": "vite",
    "dev:svelte": "npm --prefix svelte-website run dev --",
    "build": "npm --prefix svelte-website run build",
    "build:pages": "npm --prefix svelte-website run build:pages",
